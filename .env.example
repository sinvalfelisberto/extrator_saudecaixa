# Configurações opcionais do extrator. Copie este arquivo para ".env" para usar.
# O login (CPF e senha) NÃO fica aqui: você digita direto no site, na janela do navegador.

# Endereço do Saúde CAIXA (normalmente não precisa mudar).
SITE=https://atendimentosaude.caixa.gov.br/

# Quantos anos extrair por padrão, do mais recente para trás (2 = ano atual e o anterior).
# Sobrescreva numa execução com --anos N ou --todos.
ULTIMOS_ANOS=2
